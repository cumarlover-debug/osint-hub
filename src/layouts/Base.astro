---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// Pages are built as foo.html but served at /foo, so drop the extension (and "index") from the canonical URL.
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/"><span aria-hidden="true">◎</span> osint-hub</a>
        <nav>
          <a href="/">Tools</a>
          <a href="/launch">Launcher</a>
          <a href="/playbooks">Playbooks</a>
          <a href="/toolkit" class="nav-toolkit">★ Toolkit<span class="fav-count" hidden></span></a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          A directory of publicly available tools. Use them lawfully and ethically, and only for investigations
          you have a legitimate reason to carry out. <a href="/about#responsible-use">Responsible use</a>
        </p>
        <p>Your searches on this site run in your own browser and are never sent to us.</p>
        <p>Know a tool that is missing? <a href="/submit">Suggest a tool</a>.</p>
      </div>
    </footer>
    <script>
      import { wireStars, getFavourites, CHANGED } from '../lib/favourites';

      wireStars();
      const count = document.querySelector<HTMLElement>('.fav-count')!;
      const showCount = () => {
        const n = getFavourites().length;
        count.hidden = n === 0;
        count.textContent = String(n);
      };
      window.addEventListener(CHANGED, showCount);
      window.addEventListener('storage', showCount);
      showCount();
    </script>
  </body>
</html>
