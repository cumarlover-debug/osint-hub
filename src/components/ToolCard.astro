---
import { taxonomy, inputLabel, staleSince, isBroken, type Tool } from '../lib/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const { health } = tool;
const stale = staleSince(tool);
// The name without spaces and the site's host too, so "haveibeenpwned" finds "Have I Been Pwned".
const host = new URL(tool.url).hostname.replace(/^www\./, '');
// Facets, derived rather than stored: a tool is open source when it names a repository and a licence, and it runs
// on a platform only when it says so. Missing information is left missing instead of guessed at, so a filter never
// claims more than the data does.
const openSource = Boolean(tool.repo && tool.license);
const platforms = tool.platforms ?? [];
// Star counts come from the weekly health check, which reads each repository. Absent for anything without one, which
// is why the filter matches only tools that actually carry a number.
const stars = tool.health?.repo?.stars;
const searchText = [tool.name, tool.name.replace(/[^a-z0-9]/gi, ''), host, tool.description, tool.category, ...(tool.tags ?? []), ...tool.inputs]
  .join(' ')
  .toLowerCase();
---

<article
  class="card"
  data-inputs={tool.inputs.join(' ')}
  data-type={tool.type}
  data-category={tool.category}
  data-cost={tool.cost}
  data-passive={String(tool.passive)}
  data-account={String(tool.account_required)}
  data-broken={String(isBroken(tool))}
  data-open-source={String(openSource)}
  data-linux={String(platforms.includes('linux'))}
  data-byhand={String(Boolean(tool.manual))}
  data-stars={stars != null ? String(stars) : ''}
  data-search={searchText}
  data-slug={tool.slug}
>
  <button type="button" class="fav fav-card" data-slug={tool.slug} aria-pressed="false" title="Add to my toolkit">
    <span aria-hidden="true">★</span><span class="visually-hidden">Add {tool.name} to my toolkit</span>
  </button>
  <div class="card-head">
    <h3><a href={`/tools/${tool.slug}`}>{tool.name}</a></h3>
    {health?.status === 'down' && <span class="status down" title={`Failed the last ${health.failures} weekly checks`}>down</span>}
    {health?.repo?.archived && <span class="status down" title="The GitHub repository is archived">archived</span>}
    {stale && <span class="status stale" title={`No updates since ${stale}`}>stale</span>}
  </div>
  <p class="desc">{tool.description}</p>
  <ul class="badges">
    <li class="badge">{taxonomy.types[tool.type]}</li>
    <li class={`badge cost-${tool.cost}`}>{taxonomy.costs[tool.cost]}</li>
    {!tool.passive && <li class="badge warn" title="Can interact with the target or its infrastructure">Active</li>}
    {tool.account_required && <li class="badge">Account</li>}
    {stars != null && (
      <li class="badge" title={`${stars.toLocaleString('en-GB')} stars on GitHub`}>
        {stars >= 1000 ? `${Math.round(stars / 1000)}k★` : `${stars}★`}
      </li>
    )}
    {tool.manual && <li class="badge warn" title="Has to be queried by hand">By hand</li>}
  </ul>
  <p class="takes">
    <span>Takes</span>
    {tool.inputs.map((i) => <span class="input-tag">{inputLabel(i)}</span>)}
  </p>
</article>
