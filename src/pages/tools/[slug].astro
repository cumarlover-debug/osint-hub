---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools, taxonomy, inputLabel, isInputKey, toolsTaking, staleSince, type Tool } from '../../lib/tools';
import { templatesFor, commandTemplatesFor } from '../../lib/launcher';
import { playbooksUsing } from '../../lib/playbooks';
import { reportProblemUrl } from '../../lib/site';

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props as { tool: Tool };

// Outputs that are also input types are pivots: they lead to the next tools to try.
const pivots = (tool.outputs ?? [])
  .filter(isInputKey)
  .map((key) => ({ key, label: inputLabel(key), tools: toolsTaking(key, tool.slug) }))
  .filter((p) => p.tools.length > 0);

const similar = tools
  .filter((t) => t.slug !== tool.slug && t.inputs.some((i) => tool.inputs.includes(i)))
  .slice(0, 6);

const { health } = tool;
const templates = templatesFor(tool.query_template, tool.inputs);
const searchInputs = Object.keys(templates);
const usedIn = playbooksUsing(tool.slug);
// Usage lines with a placeholder, e.g. "sherlock <username>"; Docker variants after the native ones.
const placeholder = (input: string) => `<${inputLabel(input).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}>`;
const usage = [
  ...Object.entries(commandTemplatesFor(tool.command_template, tool.inputs)),
  ...Object.entries(commandTemplatesFor(tool.docker_template, tool.inputs)),
].map(([input, t]) => t.split('{query}').join(placeholder(input)));
// People search, face recognition and tools that surface an individual's contact details get a responsible-use notice.
const sensitive = tool.category === 'people' || !!tool.tags?.some((t) => t === 'face-recognition' || t === 'personal-data');
const repo = health?.repo;
const statusText = { up: 'Online', down: 'Unreachable', unverified: 'Could not verify' };
const stale = staleSince(tool);
const warnings = [
  health?.status === 'down' &&
    `The link has failed ${health.failures} weekly checks in a row (${health.reason})${health.last_ok ? `. It last worked on ${health.last_ok}` : ''}.`,
  repo?.archived && 'The GitHub repository is archived: the authors no longer maintain it.',
  repo?.missing && 'The GitHub repository no longer exists.',
  stale && `No updates since ${stale}. It may still work, but check that its sources haven't changed.`,
].filter(Boolean) as string[];

const readable =(key: string) => (isInputKey(key) ? inputLabel(key) : key.replace(/_/g, ' '));
const exampleInput = tool.inputs[0];
---

<Base title={`${tool.name}: ${taxonomy.categories[tool.category]} OSINT tool | osint-hub`} description={tool.description}>
  <nav class="crumbs"><a href="/">Tools</a> / <a href={`/?input=${exampleInput}`}>{inputLabel(exampleInput)}</a></nav>

  <article class="tool">
    <header class="tool-head">
      <h1>{tool.name}</h1>
      <p class="lede">{tool.description}</p>
      <a class="button" href={tool.url} target="_blank" rel="noopener noreferrer">Open {tool.name} ↗</a>
      <button type="button" class="fav fav-page" data-slug={tool.slug} aria-pressed="false">
        <span aria-hidden="true">★</span> <span class="fav-label">Add to my toolkit</span>
      </button>
      <p class="url">{tool.url}</p>
      <p class="hint report-link">
        Broken, moved or wrong? <a href={reportProblemUrl(tool.name, tool.slug)} target="_blank" rel="noopener noreferrer">Report a problem</a>
      </p>
    </header>

    <dl class="facts">
      <div><dt>Type</dt><dd>{taxonomy.types[tool.type]}</dd></div>
      <div><dt>Cost</dt><dd>{taxonomy.costs[tool.cost]}</dd></div>
      <div>
        <dt>Touches the target?</dt>
        <dd>{tool.passive ? 'No, passive' : 'Yes, can be active'}</dd>
      </div>
      <div><dt>Account needed</dt><dd>{tool.account_required ? 'Yes' : 'No'}</dd></div>
      <div><dt>Category</dt><dd>{taxonomy.categories[tool.category]}</dd></div>
      {tool.language && <div><dt>Language</dt><dd>{tool.language}</dd></div>}
      {tool.license && <div><dt>License</dt><dd>{tool.license}</dd></div>}
      {tool.platforms && <div><dt>Platforms</dt><dd>{tool.platforms.join(', ')}</dd></div>}
      {repo?.stars !== undefined && <div><dt>GitHub stars</dt><dd>{repo.stars.toLocaleString('en')}</dd></div>}
      {repo?.pushed_at && <div><dt>Last updated</dt><dd>{repo.pushed_at}</dd></div>}
      {
        health && (
          <div>
            <dt>Link status</dt>
            <dd>
              <span class={`dot ${health.status}`} aria-hidden="true" />
              {statusText[health.status]}, checked {health.last_checked}
            </dd>
          </div>
        )
      }
    </dl>

    {sensitive && (
      <aside class="note">
        <p>
          <strong>Responsible use:</strong> this tool can surface personal information about private individuals. Use it
          only with a legitimate purpose (research, journalism, security work, personal safety), check the laws where you
          are, and never to stalk, harass or expose someone. Results are often wrong or out of date, so verify before
          acting on them. <a href="/about#responsible-use">Our policy</a>
        </p>
      </aside>
    )}

    {warnings.length > 0 && (
      <aside class="note danger">
        {warnings.map((w) => <p>{w}</p>)}
      </aside>
    )}

    <section class="flow" aria-label="Inputs and outputs">
      <div>
        <h2>Takes</h2>
        <ul class="tag-list">
          {tool.inputs.map((i) => <li><a class="input-tag" href={`/?input=${i}`}>{inputLabel(i)}</a></li>)}
        </ul>
      </div>
      {
        tool.outputs && (
          <div>
            <h2>Gives you</h2>
            <ul class="tag-list">
              {tool.outputs.map((o) => <li><span class="input-tag muted">{readable(o)}</span></li>)}
            </ul>
          </div>
        )
      }
    </section>

    {
      searchInputs.length > 0 && (
        <section class="panel">
          <h2>Search {tool.name} directly</h2>
          <p class="hint">
            Opens {tool.name} in a new tab. Your search goes straight from your browser to {tool.name}, not through this
            site. To search many tools at once, use the <a href="/launch">launcher</a>.
          </p>
          <form class="launcher" data-templates={JSON.stringify(templates)}>
            {searchInputs.length > 1 && (
              <select aria-label="What are you searching for?">
                {searchInputs.map((i) => <option value={i}>{inputLabel(i)}</option>)}
              </select>
            )}
            <label class="visually-hidden" for="launch-q">Value to search</label>
            <input id="launch-q" type="text" required placeholder={`Enter ${inputLabel(searchInputs[0]).toLowerCase()}`} autocomplete="off" />
            <button type="submit" class="button">Search ↗</button>
          </form>
          <p class="hint launcher-error" hidden></p>
        </section>
      )
    }

    {
      (tool.install || usage.length > 0) && (
        <section class="panel">
          <h2>{tool.install ? 'Install' : 'Get it'}</h2>
          {tool.install && (
            <div class="code">
              <code>{tool.install}</code>
              <button type="button" class="copy" data-copy={tool.install}>Copy</button>
            </div>
          )}
          {usage.length > 0 && (
            <>
              <h3>Run it</h3>
              {usage.map((u) => (
                <div class="code">
                  <code>{u}</code>
                </div>
              ))}
              <p class="hint">
                Replace the part in angle brackets, or paste your value into the <a href="/launch">launcher</a> to get the
                exact command, safely quoted for your shell.
              </p>
            </>
          )}
          {tool.repo && (
            <p class="hint">
              Source: <a href={`https://github.com/${tool.repo}`} target="_blank" rel="noopener noreferrer">github.com/{tool.repo}</a>
              {tool.docker && ' · Docker image available'}
            </p>
          )}
        </section>
      )
    }

    {
      tool.notes && (
        <aside class="note">
          <strong>Before you use it:</strong> {tool.notes}
        </aside>
      )
    }

    {
      pivots.length > 0 && (
        <section>
          <h2>Where to go next</h2>
          <p class="hint">Found something with {tool.name}? These tools take it as input.</p>
          {pivots.map((p) => (
            <div class="pivot">
              <h3>{p.label} →</h3>
              <ul class="pill-links">
                {p.tools.map((t) => <li><a href={`/tools/${t.slug}`}>{t.name}</a></li>)}
              </ul>
            </div>
          ))}
        </section>
      )
    }

    {
      usedIn.length > 0 && (
        <section>
          <h2>Used in playbooks</h2>
          <ul class="pill-links">
            {usedIn.map((p) => (
              <li><a href={`/playbooks/${p.slug}`}>{p.title}</a></li>
            ))}
          </ul>
        </section>
      )
    }

    {
      similar.length > 0 && (
        <section>
          <h2>Similar tools</h2>
          <div class="grid">{similar.map((t) => <ToolCard tool={t} />)}</div>
        </section>
      )
    }
  </article>
</Base>

<script>
  import { applies, buildLink, MATCH_LABELS, type Template } from '../../lib/launcher';

  for (const form of document.querySelectorAll<HTMLFormElement>('.launcher')) {
    const templates = JSON.parse(form.dataset.templates!) as Record<string, Template>;
    const select = form.querySelector('select');
    const input = form.querySelector('input')!;
    const error = form.nextElementSibling as HTMLElement;
    select?.addEventListener('change', () => {
      input.placeholder = `Enter ${select.selectedOptions[0].text.toLowerCase()}`;
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const value = input.value.trim();
      const template = templates[select?.value ?? Object.keys(templates)[0]];
      if (!value) return;
      if (!applies(template, value)) {
        error.textContent = `This search only works with ${MATCH_LABELS[template.match!]}.`;
        error.hidden = false;
        return;
      }
      error.hidden = true;
      window.open(buildLink(template, value), '_blank', 'noopener,noreferrer');
    });
  }
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.copy')) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Copy failed';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1500);
    });
  }
</script>
