{
  "name": "osint-hub",
  "version": "1.0.0",
  "description": "A searchable directory of OSINT tools, organised by what you are investigating.",
  "scripts": {
    "dev": "astro dev",
    "test": "node --test",
    "validate": "node scripts/validate.mjs",
    "build": "npm run validate && astro build",
    "check": "npm test && npm run build",
    "preview": "astro preview",
    "healthcheck": "node scripts/healthcheck.mjs",
    "pipeline:harvest": "node scripts/pipeline/harvest.mjs",
    "pipeline:draft": "node scripts/pipeline/draft.mjs",
    "pipeline:promote": "node scripts/pipeline/promote.mjs",
    "cli": "node cli/osint-hub.mjs",
    "extension:sync": "node -e \"require('fs').copyFileSync('shared/launcher.mjs','extension/lib/launcher.mjs')\" && node scripts/extension-icons.mjs",
    "templates": "node scripts/template-check.mjs",
    "forms:mark": "node scripts/mark-forms.mjs",
    "skill:install": "node scripts/install-skill.mjs",
    "dsh:selftest": "node dsh-plugin/selftest.mjs"
  },
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "astro": "^7.3.5",
    "js-yaml": "^4.3.2",
    "ajv": "^8.20.0"
  },
  "private": true,
  "bin": {
    "osint-hub": "cli/osint-hub.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "cli",
    "shared"
  ]
}
